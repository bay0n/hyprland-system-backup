bind = $mainMod, down,  movefocus, d








#layouts for keyboard

input {
    kb_layout = de
}
dwindle {
    # 0 = forced vertical, 1 = forced horizontal, 2 = automatic based on aspect ratio
    force_split = 2
    preserve_split = 1

}

device {
    name = razer-razer-viper-v3-hyperspeed
    middle_button_emulation = false
}

device {
    name = razer-razer-viper-v3-hyperspeed-2
    middle_button_emulation = false
}

cursor {
    no_hardware_cursors = 0
}

decoration {
    rounding = 10
    active_opacity = 0.85        # focused window
    inactive_opacity = 0.85      # unfocused windows
    fullscreen_opacity = 1.0    # fullscreen stays solid


    shadow {
        enabled = true
        range = 3
        render_power = 3
        color = rgba(1a1a1aee)
    }

    blur {
        enabled = false
        size = 3
        passes = 1
        vibrancy = 0.1696
    }
}
general {
    col.active_border = rgba(cba6f7ff)     # focused window border
    col.inactive_border = rgba(585b70ff)   # unfocused window border
    border_size = 2                         # thickness in pixels

    resize_on_border = false
}
#random but needed


#windowrules

# Force Quickshell script into fullscreen
hl.window_rule({  match = { class = "quickshell" },  fullscreen = true})

# Handle ZapZap workspace, layout, and border properties
hl.window_rule({  match = { class = "ZapZap", workspace = "active", float = false },  border_size = 2})

bind = $mainMod, left,  movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up,    movefocus, u
bind = $mainMod, down,  movefocus, d








