env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card0

exec-once = sleep 2 && wayvnc --gpu --max-fps=60 --output=DP-3 0.0.0.0 5900
exec-once = sleep 2 && elephant
exec-once = sleep 2 && nm-applet
exec-once = sleep 2 && waybar
exec-once = sleep 2 && mako
exec-once = sleep 2 && hypridle
exec-once = sleep 2 && ~/.config/hypr/xdg-portal-init.sh
exec-once = sleep 2 && awww-daemon



$mainMod = SUPER
$terminal = kitty
$fileManager = nautilus
$menu = rofi -show drun
$browser = firefox



#monitor setup
monitor = eDP-1, 1920x1080@144.00, 0x0, 1
monitor = HDMI-A-1, 1920x1080@60.00, 1920x0, 1



#keybindings



# Enter resize mode with Super + R
bind = $mainMod, R, submap, resize


bind = SUPER, W, exec, dms ipc call wallpaperCarousel open


bindm = $mainMod, mouse:272, movewindow

bindm = $mainMod, mouse:273, resizewindow

binde = $mainMod,RETURN,exec, $terminal

binde = $mainMod&SHIFT, Q, killactive,

bind = $mainMod&SHIFT, E, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit

binde = $mainMod, E, exec, $fileManager

binde = $mainMod, s, exec, $browser

bind = $mainMod, V, togglefloating,

bind = $mainMod, D, exec, $menu

bind = $mainMod, C, exec, rofi -show calc -modi calc -no-show-match -no-sort

bind = $mainMod&SHIFT, S , exec, hyprshot -z -m region

bind = $mainMod&SHIFT,adiaeresis , exec, flatpak run com.lunarclient.LunarClient

bind = $mainMod&SHIFT, T, exec, ~/.config/hypr/scripts/toggle_opacity.sh

bind = $mainMod, F, fullscreen, 0

bind = $mainMod, M, fullscreen, 1

bind = $mainMod, K, killactive

bind = $mainMod, H, layoutmsg, togglesplit




# Lock the screen using Super + L
bind = $mainMod, L, exec, hyprlock




submap = resize
# Use arrow keys or vim keys to resize
binde = , right, resizeactive, 50 0
binde = , left, resizeactive, -50 0
binde = , up, resizeactive, 0 -50
binde = , down, resizeactive, 0 50
binde = , l, resizeactive, 50 0
binde = , h, resizeactive, -500 0
binde = , k, resizeactive, 0 -50
binde = , j, resizeactive, 0 50
# Exit resize mode
bind = , escape, submap, reset
bind = , return, submap, reset
submap = reset


# --- HARDWARE KEYS ---
# Volume Control
binde = , XF86AudioRaiseVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ +10%
binde = , XF86AudioLowerVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ -10%
bindl = , XF86AudioMute, exec, pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness Control
binde = , XF86MonBrightnessUp, exec, ~/.config/hypr/scripts/brightness-sync.sh +5%
binde = , XF86MonBrightnessDown, exec, ~/.config/hypr/scripts/brightness-sync.sh 5%-


# --- MEDIA CONTROLS (MX KEYS S) ---
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous

# --- MICROPHONE CONTROLS ---
# Toggles the microphone on/off and works on the lock screen
bindr = , XF86AudioMicMute, exec, pactl set-source-mute @DEFAULT_SOURCE@ toggle

#scratchpad
# Toggle the scratchpad visibility
bind = $mainMod, X, togglespecialworkspace, scratchpad

# Send the active window to the scratchpad silently
bind = $mainMod SHIFT, X, movetoworkspacesilent, special:scratchpad

# Move the focused scratchpad window back to the current active workspace
bind = $mainMod SHIFT, Y, movetoworkspace, e+0

# workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9

# move window to workspace
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9

# Move window focus and across monitors
bind = $mainMod SHIFT, left,  movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up,    movewindow, u
bind = $mainMod SHIFT, down,  movewindow, d

# move focus#                   _______  _______  _        _______  _        ______
#|\     /||\     /|(  ____ )(  ____ )( \      (  ___  )( (    /|(  __  \
#| )   ( |( \   / )| (    )|| (    )|| (      | (   ) ||  \  ( || (  \  )
#| (___) | \ (_) / | (____)|| (____)|| |      | (___) ||   \ | || |   ) |
#|  ___  |  \   /  |  _____)|     __)| |      |  ___  || (\ \) || |   | |
#| (   ) |   ) (   | (      | (\ (   | |      | (   ) || | \   || |   ) |
#| )   ( |   | |   | )      | ) \ \__| (____/\| )   ( || )  \  || (__/  )
#|/     \|   \_/   |/       |/   \__/(_______/|/     \||/    )_)(______/

env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card0

exec-once = sleep 2 && wayvnc --gpu --max-fps=60 --output=DP-3 0.0.0.0 5900
exec-once = sleep 2 && elephant
exec-once = sleep 2 && nm-applet
exec-once = sleep 2 && waybar
exec-once = sleep 2 && mako
exec-once = sleep 2 && hypridle
exec-once = sleep 2 && ~/.config/hypr/xdg-portal-init.sh
exec-once = sleep 2 && awww-daemon



