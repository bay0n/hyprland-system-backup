* {
    background-color: #0f1117;
    border-color:     #2a2d3a;
    text-color:       #7a8099;
    font:             "JetBrains Mono 13";
}

window {
    width:            600px;
    border:           1px;
    border-radius:    10px;
    padding:          0;
}

mainbox {
    children: [inputbar, listview];
    spacing:  0;
}

inputbar {
    background-color: #0f1117;
    border-color:     #1e2130;
    border:           0 0 1px 0;
    padding:          10px 14px;
    children:         [prompt, textbox-prompt-colon, entry];
    spacing: 0;
}

prompt {
    text-color:  #9d7ec7;
    font:        inherit;
    expand:      false;
}

textbox-prompt-colon {
    str:        " ❯ ";
    text-color: #2a2d3a;
    margin:     0;
    padding:    0;
    expand:     false;
}

entry {
    text-color:       #c5cce8;
    cursor-color:     #6e7ebb;
    horizontal-align: 0;
    vertical-align:   0.5;
    expand:           true;
    placeholder:      "";
    xalign:           0;
}

listview {
    padding:   6px 0;
    scrollbar: true;
    lines:     8;
}

element {
    padding:    7px 16px;
    spacing:    10px;
    text-color: #7a8099;
}


element selected {
    background-color: #1a1e2e;
    text-color:       #c5cce8;
    border-color:     #9d7ec7;
    border:           0 0 0 2px;
}

element-text {
    text-color: inherit;
    background-color: inherit;
}

scrollbar {
    width:        3px;
    handle-color: #2a2d3a;
    handle-width: 3px;
}
